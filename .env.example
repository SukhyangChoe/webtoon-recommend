# 웹툰궁합의 공개 URL. 공유 링크와 향후 서버 API의 기준 주소로 사용합니다.
NEXT_PUBLIC_WEBTOON_MATCH_BASE_URL=http://localhost:3000/match

# Supabase Connect > Direct > Transaction pooler의 서버 전용 연결 문자열입니다.
# 브라우저에 노출되는 NEXT_PUBLIC_ 변수로 만들거나 저장소에 실제 값을 커밋하지 마세요.
WEBTOON_MATCH_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres
