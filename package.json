{
  "name": "webtoon-recommend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/daily-recommendation/verify-runtime.cjs && next build --webpack && node scripts/check-client-catalog-boundary.mjs",
    "check:catalog-boundary": "node scripts/check-client-catalog-boundary.mjs",
    "start": "next start",
    "lint": "eslint",
    "test:match": "node --test tests/match/*.test.mjs",
    "check:daily-runtime": "node scripts/daily-recommendation/check-runtime.mjs",
    "check:daily-avoidance": "node -r ./scripts/daily-recommendation/portable-paths.cjs scripts/daily-recommendation/check-avoidance.cjs",
    "check:daily-performance": "node -r ./scripts/daily-recommendation/portable-paths.cjs scripts/daily-recommendation/check-performance.cjs",
    "report:match-pilot": "node --env-file=.env.local scripts/webtoon-match-pilot-export.mjs",
    "sync:webtoon-catalog": "node --env-file=.env.local scripts/sync-webtoon-catalog.mjs --apply",
    "check:webtoon-catalog": "node --env-file=.env.local scripts/sync-webtoon-catalog.mjs --dry-run"
  },
  "dependencies": {
    "next": "16.2.9",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
